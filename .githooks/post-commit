#!/bin/sh
# После коммита в main отправить его на сервер: там хук post-receive выкатывает бота.
# Коммиты в другие ветки (и во время rebase) не отправляются.
[ "$(git rev-parse --abbrev-ref HEAD)" = "main" ] || exit 0
git remote get-url server >/dev/null 2>&1 || exit 0

if ! git push server main; then
    echo "post-commit: на сервер не отправлено, повтори вручную: git push server main"
fi

#!/bin/sh
# Выкатка бота после `git push server main` (репозиторий в папке бота, receive.denyCurrentBranch=updateInstead:
# файлы в папке к этому моменту уже обновлены).
# 1) сборка образа; 2) pytest во временном контейнере из этого образа на файлах коммита
#    (без .env и файлов вне git); 3) только при зелёных тестах перезапуск контейнера бота.
# Если сборка или тесты упали, продолжает работать старый контейнер. Вывод виден у того, кто пушит.
# Установка: cp deploy/post-receive .git/hooks/post-receive && chmod +x .git/hooks/post-receive
set -e

deploy=no
while read -r old new ref; do
    [ "$ref" = "refs/heads/main" ] && deploy=yes
done
[ "$deploy" = yes ] || exit 0

# Хуки пуша запускаются внутри .git: переходим в папку бота
cd "$(cd "$GIT_DIR" && pwd)/.."
unset GIT_DIR

echo "deploy: $(git log -1 --oneline)"
docker compose build
image="$(docker compose config --images | head -n 1)"  # образ бота из docker-compose.yml

echo "deploy: pytest..."
if ! git archive HEAD | docker run --rm -i "$image" sh -c \
    "mkdir /src && tar -x -C /src && cd /src \
     && pip install -q --root-user-action=ignore -r requirements-dev.txt \
     && python -m pytest -q -p no:cacheprovider"; then
    echo "deploy: ТЕСТЫ УПАЛИ, бот не перезапущен (работает прежняя версия)"
    exit 1
fi

docker compose up -d
docker compose ps

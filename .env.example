# Скопируйте в .env и заполните. Все значения обязательны, кроме блоков с пометкой «необязательно».
# Модель настроек со всеми ключами: settings.py (класс Settings).

# --- Discord ---
DISCORD_TOKEN=

# --- MongoDB ---
MONGO_URL=

# --- Выключаемые фичи: true/false (по умолчанию false) ---
LOBBY_MONITOR_ENABLED=false
TOURNAMENT_ENABLED=false
GRAPHS_ENABLED=false
GRAPHS_DAILY_ENABLED=false

# --- Доступ к API игры (мониторинг лобби), необязательно ---
GAME_HEADER_AUTHORIZATION=
GAME_AUTH_LOGIN=
GAME_AUTH_PASSWORD=
EXTERNAL_AUTH_TOKEN=
DEPLOYMENT_ID=
NONCE=
DISPLAY_NAME=

# --- Twitch API, необязательно (без них не работают Twitch-оповещения) ---
TWITCH_CLIENT_ID=
TWITCH_CLIENT_SECRET=

# --- Twitch: категория и уведомления ---
TWITCH_MONITOR_ENABLED=false
TWITCH_CATEGORY_ID=
TWITCH_STREAMS_ROLE_ID=
DISCORD_CHANNEL_ID_FOR_TWITCH_NOTIFICATIONS=
DISCORD_CHANNEL_ID_FOR_TWITCH_MONITORING=
MY_TWITCH_LOGIN=
MY_STREAM_ROLE_ID=
MY_STREAM_CHANNEL_ID_1=
MY_STREAM_CHANNEL_ID_2=

# --- Telegram-бот (telegram_polls/), Discord-ботом не читается ---
TELEGRAM_TOKEN=

# --- Игровые серверы (SSH) ---
GAME_SSH_KEY_PATH=
GAME_SERVER_1_HOST=
GAME_SERVER_1_USER=
GAME_SERVER_1_FOLDER=
GAME_SERVER_2_HOST=
GAME_SERVER_2_USER=
GAME_SERVER_2_FOLDER=
GAME_SERVER_3_HOST=
GAME_SERVER_3_USER=
GAME_SERVER_3_FOLDER=

# --- Веб-сервер (графики, карты матчей) ---
SITE_URL=
WEB_HOST=
WEB_USER=
WEB_SSH_KEY_PATH=
WEB_ROOT=

# --- Статистика матчей ---
STATS_CSV_FOLDER=
STATS_CSV_PROCESSED_FOLDER=

# --- Discord: пользователи и роли (ID через запятую) ---
ADMIN_IDS=
MODERATOR_ROLE_ID=
EXTENDED_ACCESS_ROLE_ID=
HOSTER_ROLE_ID=
HOST_REQUEST_PING_USER_ID=

# --- Discord: каналы ---
LOBBY_CHANNEL_ID=
NOTIFY_CHANNEL_ID=
TOURNAMENT_TRACK_CHANNEL_ID=
PANEL_CHANNEL_ID=
COMMANDS_CHANNEL_IDS=
HOST_REQUEST_CHANNEL_ID=
HISTORY_CHANNEL_ID=
RESERVATION_LOG_CHANNEL_ID=
REPORTS_LOG_CHANNEL_ID=
ELO_LOG_CHANNEL_ID=
ELO_CALCULATOR_LOG_CHANNEL_ID=
MATCH_RESULTS_CHANNEL_ID=
PENALTY_LOG_CHANNEL_ID=
LEADERBOARD_CHANNEL_ID=
DUOS_CHANNEL_ID=
SHARE_CHANNEL_ID=

# --- Ссылки в текстах бота ---
DONATION_URL=
TELEGRAM_CONTACT_URL=
RELICMOD_DOWNLOAD_URL=
PATCHER_FIX_URL=
COMMUNITY_PATCHER_URL=
COMMUNITY_RECONNECTOR_URL=

# --- Игровые серверы: включение ---
# Отключённые вручную серверы, номера с 0 через запятую (пусто: все включены). Меняется без коммита:
# правка .env и `docker compose up -d` (restart не перечитывает .env)
DISABLED_SERVERS=
# Необязательно: строка под сообщением «Сервера на данный момент недоступны», когда отключены все
SERVERS_UNAVAILABLE_NOTE=
